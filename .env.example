# ---- Snowflake (required; there is no SQLite fallback) ----
SNOWFLAKE_ACCOUNT=xy12345.region.snowflakecomputing.com
SNOWFLAKE_USER=dg_pipeline
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=DG_PIPELINE
SNOWFLAKE_WAREHOUSE=DG_WH
SNOWFLAKE_DATABASE=DOMAINGUARD
SNOWFLAKE_TIMEOUT_S=30

# ---- CertStream (self-hosted: scripts/certstream.sh) ----
CERTSTREAM_URL=ws://localhost:8080

# ---- Feeds ----
OPENPHISH_URL=https://raw.githubusercontent.com/openphish/public_feed/main/feed.txt
URLHAUS_URL=https://urlhaus-api.abuse.ch/v2/files/exports/4d21b1825663ea38946d71e514d39c84c4e59d4ba6d341e7/recent.csv
URLHAUS_AUTH_KEY=
RDAP_MIN_INTERVAL_S=1.0

# ---- Ingestion ----
DG_STAGE_DIR=stage
DG_STATE_DIR=state
DG_FLUSH_ROWS=200
DG_FLUSH_SECONDS=60
DG_WATCHLIST_TTL_S=30

# ---- LLM (optional; template used if empty) ----
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-2-7b-chat:free,mistralai/mistral-7b-instruct:free
LLM_MAX_CALLS_PER_RUN=20

# ---- Email (SMTP; SES is not implemented in this build) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@domainguard.example.com

# ---- API and web ----
API_RATE_LIMIT_PER_MIN=60
API_KEY_RATE_LIMIT_PER_MIN=1000
WEB_DOMAIN=http://127.0.0.1:8000
PUBLIC_ORIGIN=
DG_DISPUTE_URL=
DG_ANALYST_TOKEN=
DG_SECRET_KEY=                  # required: signs unsubscribe links. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
VIRUSTOTAL_API_KEY=             # optional: read-only URL reputation checks for the public checker
REPUTATION_TIMEOUT_S=6
TURNSTILE_SITE_KEY=             # optional until enabled; public site key only
TURNSTILE_SECRET_KEY=           # server-only; never expose or commit
CAPTCHA_TIMEOUT_S=5
REGISTRATION_RATE_LIMIT_PER_HOUR=5
OTP_RATE_LIMIT_PER_HOUR=10
LOG_LEVEL=INFO
